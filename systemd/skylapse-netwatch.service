[Unit]
# @SKYLAPSE_ROOT@ / @SKYLAPSE_USER@ are substituted by install.sh at install
# time — see skylapse-daemon.service for why this runs from the git checkout
# rather than an /opt copy.
#
# Verified on hardware 2026-08-16: fallback, the guarded rescan home, manual
# access-point mode, and the client-connected freeze — the last with a real
# phone attached, which is the only way that guard can be exercised.
Description=Skylapse network watchdog
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
ExecStart=@SKYLAPSE_ROOT@/venv/bin/skylapse-netwatch
WorkingDirectory=@SKYLAPSE_ROOT@
Restart=always
RestartSec=5
WatchdogSec=30
NotifyAccess=main
Type=notify
# Manipulates NetworkManager connections, so unlike the daemon and API this one
# genuinely needs root — it is the reason the three services are separate units.
# Runs as root, so without a Group= this unit would create /run/skylapse owned
# by root:root 0755 whenever it happens to start first — and the daemon and api
# run as an ordinary user, which would leave them unable to write their status
# files at all. Group + group-writable makes the outcome the same in any start
# order. (Root itself can write into the 0755 directory the others create, so
# only this direction needs handling.)
Group=@SKYLAPSE_USER@
RuntimeDirectory=skylapse
RuntimeDirectoryMode=0775
RuntimeDirectoryPreserve=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
