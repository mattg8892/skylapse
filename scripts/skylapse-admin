#!/usr/bin/env bash
# The one privileged thing Skylapse is allowed to do to its own host.
#
# The services run unprivileged. A few operations genuinely need root — editing
# /boot/firmware/config.txt to enable a camera overlay, installing the ZWO SDK
# into /usr/local/lib, restarting units, and rebooting — and the alternative to
# this script is a sudoers rule with a wildcard, which is just root with extra
# steps.
#
# So: one entry in /etc/sudoers.d/skylapse pointing here, no wildcards, and
# every argument validated below rather than by sudo's pattern matching.
set -euo pipefail

# Overridable so the tests can exercise the real script against a real file
# instead of a reimplementation of it. This writes to a root-owned boot config;
# a bug here costs a card that will not come back up.
CONFIG="${SKYLAPSE_CONFIG_TXT:-/boot/firmware/config.txt}"
[ -f "$CONFIG" ] || CONFIG=/boot/config.txt          # pre-Bookworm layout

# The checkout this script belongs to: scripts/ sits directly under it.
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="${SKYLAPSE_ROOT:-$(dirname "$SELF_DIR")}"

# Units the updater restarts. netwatch is deliberately not here: it owns the
# radio, and taking Wi-Fi down underneath the phone watching the update is not
# a thing to do for a change it can pick up at the next boot.
SERVICES="skylapse-daemon skylapse-api"

# Sensors whose overlays ship with Raspberry Pi OS. A closed list, because this
# value reaches a root-owned boot file: anything not named here is refused
# rather than written and discovered at the next boot, when the camera is on a
# pole and the only feedback is that it did not come back.
SENSORS="imx477 imx708 imx219 imx296 imx519 ov5647 ov9281 imx290 imx378"

# -- ZWO SDK ----------------------------------------------------------------
#
# ZWO's licence does not allow their SDK to be redistributed, and their download
# portal is browser-only, so the shared library cannot ship inside the SD image.
# That left a ZWO rig as the one setup needing SSH — the single thing this whole
# appliance exists to avoid. Fetching it on demand, once, with the user
# accepting ZWO's terms, closes that gap without redistributing anything.
#
# The INDI project mirrors the same vendor binaries. Pinned to a tag and
# checksummed rather than tracking a branch: this is an unsigned binary from a
# third party landing in /usr/local/lib as root, so "whatever is at that URL
# today" is not good enough. Update the ref and both hashes together.
ZWO_REF="v2.2.4.1"
ZWO_SDK_VERSION="1.41"                  # ASICAM_VERSION at that ref
ZWO_LIB_SHA256="3ecf511979ed571131e7d7f4a467112aba21940b4dc91d63bd109b9683bf67c4"
ZWO_RULES_SHA256="93a2f52cf4849359d94754e702a3ab0fd667ea8548c87d3f6805cafd340569a7"

# Overridable so the tests can drive the real script — same reasoning as
# CONFIG above. sudo does not pass the environment through, so nothing reachable
# from the API can set any of these.
ZWO_BASE_URL="${SKYLAPSE_ZWO_BASE_URL:-https://raw.githubusercontent.com/indilib/indi-3rdparty/$ZWO_REF/libasi}"
ZWO_LIB_SHA256="${SKYLAPSE_ZWO_LIB_SHA256:-$ZWO_LIB_SHA256}"
ZWO_RULES_SHA256="${SKYLAPSE_ZWO_RULES_SHA256:-$ZWO_RULES_SHA256}"
LIB_DIR="${SKYLAPSE_LIB_DIR:-/usr/local/lib}"
UDEV_DIR="${SKYLAPSE_UDEV_DIR:-/etc/udev/rules.d}"
ARCH="${SKYLAPSE_ARCH:-$(uname -m)}"

# -- Tailscale --------------------------------------------------------------
#
# Remote access is Tailscale, and Tailscale is not in Debian, so it comes from
# the vendor's own signed apt repository — the method they document. Unlike the
# ZWO SDK there is no checksum to pin here and that is correct rather than lax:
# this is a repository, not a file. The keyring is fetched over TLS from the
# vendor's domain once, and from then on apt verifies every package against it,
# including upgrades we will never see.
#
# Not preinstalled in the SD image on purpose. A VPN client daemon running on
# every camera by default, and a third-party apt source in every image's
# sources.list, is a bigger thing to opt someone into than a feature they can
# turn on in one tap when they want it.
TS_KEYRING=/usr/share/keyrings/tailscale-archive-keyring.gpg
TS_SOURCES=/etc/apt/sources.list.d/tailscale.list
TS_BASE_URL="${SKYLAPSE_TS_BASE_URL:-https://pkgs.tailscale.com/stable/debian}"

os_codename() {
    codename="${SKYLAPSE_OS_CODENAME:-}"
    if [ -z "$codename" ] && [ -r /etc/os-release ]; then
        # shellcheck disable=SC1091
        codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"
    fi
    # Reaches a URL, so it is validated rather than trusted. Anything that is
    # not a plain release name is a system we do not know how to serve.
    case "$codename" in
        "" | *[!a-z0-9]*) return 1 ;;
        *) echo "$codename" ;;
    esac
}

usage() {
    echo "usage: skylapse-admin {camera-overlay <sensor>|zwo-sdk|reboot" >&2
    echo "                       |update <ref> [--now]|restart-services" >&2
    echo "                       |tailscale-install|tailscale-up" >&2
    echo "                       |tailscale-serve|tailscale-down|tailscale-status" >&2
    echo "                       |reinstall-units|i2c-enable}" >&2
    exit 2
}

# Fetch one file and refuse it unless it hashes to what we expect.
fetch_verified() {
    url="$1"; dest="$2"; want="$3"
    curl -fsSL --retry 3 --connect-timeout 15 --max-time 600 -o "$dest" "$url" || {
        echo "download failed: $url" >&2; return 1; }
    got="$(sha256sum "$dest" | cut -d' ' -f1)"
    if [ "$got" != "$want" ]; then
        rm -f "$dest"
        echo "checksum mismatch for $url" >&2
        echo "  expected $want" >&2
        echo "  got      $got" >&2
        return 1
    fi
}

case "${1:-}" in
  camera-overlay)
    sensor="${2:-}"
    [ -n "$sensor" ] || usage
    # shellcheck disable=SC2086
    case " $SENSORS " in
        *" $sensor "*) ;;
        *) echo "unknown sensor: $sensor" >&2; exit 3 ;;
    esac

    cp -n "$CONFIG" "$CONFIG.skylapse-backup" 2>/dev/null || true

    # Auto-detect reads an EEPROM that third-party boards do not have, and it
    # takes precedence over an explicit overlay, so it has to go off for a
    # declared sensor to bind at all.
    if grep -q '^camera_auto_detect=' "$CONFIG"; then
        sed -i 's/^camera_auto_detect=.*/camera_auto_detect=0/' "$CONFIG"
    else
        printf '\ncamera_auto_detect=0\n' >> "$CONFIG"
    fi

    # Both ports. Which connector a camera is in is not something anyone should
    # have to know, and the port without one fails its probe harmlessly — that
    # is exactly what a working rig's log looks like.
    for port in cam0 cam1; do
        line="dtoverlay=$sensor,$port"
        grep -qxF "$line" "$CONFIG" || printf '%s\n' "$line" >> "$CONFIG"
    done
    echo "enabled $sensor on cam0 and cam1"
    ;;

  zwo-sdk)
    # aarch64 only. The mirror also carries armv6/armv7 builds, but the SD
    # image is 64-bit Pi OS and shipping a path nobody here has ever run is
    # worse than saying plainly that it is not covered.
    if [ "$ARCH" != "aarch64" ]; then
        echo "ZWO support needs 64-bit Raspberry Pi OS (this system is $ARCH)" >&2
        exit 4
    fi
    command -v curl >/dev/null 2>&1 || { echo "curl is not installed" >&2; exit 5; }

    # Staged in a temp dir and verified before anything reaches /usr/local: a
    # half-downloaded library installed under the real name would be found by
    # the loader and fail at dlopen, which reads as broken hardware.
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT

    lib="$LIB_DIR/libASICamera2.so.$ZWO_SDK_VERSION"
    if [ -f "$lib" ] && \
       [ "$(sha256sum "$lib" | cut -d' ' -f1)" = "$ZWO_LIB_SHA256" ]; then
        echo "libASICamera2 $ZWO_SDK_VERSION already installed"
    else
        fetch_verified "$ZWO_BASE_URL/armv8/libASICamera2.bin" \
                       "$tmp/libASICamera2.so" "$ZWO_LIB_SHA256" || exit 6
        mkdir -p "$LIB_DIR"
        install -m 0644 "$tmp/libASICamera2.so" "$lib"
        # soname first, then the development link the driver's search path uses.
        ln -sf "libASICamera2.so.$ZWO_SDK_VERSION" "$LIB_DIR/libASICamera2.so.1"
        ln -sf "libASICamera2.so.1" "$LIB_DIR/libASICamera2.so"
        echo "installed libASICamera2 $ZWO_SDK_VERSION"
    fi

    # Without these the camera enumerates but opens as root only, and the USB
    # buffer stays at the 16MB default — too small for a 12-bit full-frame
    # capture, which then fails partway through rather than at open.
    rules="$UDEV_DIR/99-asi.rules"
    if [ -f "$rules" ] && \
       [ "$(sha256sum "$rules" | cut -d' ' -f1)" = "$ZWO_RULES_SHA256" ]; then
        echo "udev rules already installed"
    else
        fetch_verified "$ZWO_BASE_URL/99-asi.rules" \
                       "$tmp/99-asi.rules" "$ZWO_RULES_SHA256" || exit 6
        mkdir -p "$UDEV_DIR"
        install -m 0644 "$tmp/99-asi.rules" "$rules"
        echo "installed udev rules"
    fi

    # Guarded: the tests run this script on a machine with neither, and a rig
    # that has both files in place is already better off than one that aborted
    # here. `if` rather than `&&` — under `set -e` a false `&&` would end the
    # script one line short of reporting success.
    if command -v ldconfig >/dev/null 2>&1; then
        ldconfig
    fi
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules && udevadm trigger
    fi
    echo "zwo-sdk ready"
    ;;

  update)
    # Launch the in-app updater's worker outside the API's cgroup.
    #
    # This used to be built in Python and run as `sudo -n systemd-run --collect
    # --quiet --uid=… --working-directory=… --unit=skylapse-update …`, matched
    # against a sudoers rule that spelled the arguments out. The rule listed
    # --unit= immediately after --quiet; the command had --uid= and
    # --working-directory= in between. So it matched nothing, sudo asked for a
    # password, and `sudo -n` failed with "a password is required" — meaning
    # the updater could never be started from the web UI on any install.
    #
    # A sudoers rule that spells out an argument list is a rule that breaks the
    # next time anyone adds a flag, silently and only in production. Hence this:
    # the argument list lives here, next to the thing it launches, and sudo only
    # has to know about one script.
    ref="${2:-}"
    [ -n "$ref" ] || usage
    # This becomes a git ref. Refuse anything that could be an option or a
    # shell surprise rather than passing it through as root.
    case "$ref" in
        -*|*[!A-Za-z0-9._/-]*)
            echo "unsafe ref: $ref" >&2; exit 3 ;;
    esac
    now=""
    [ "${3:-}" = "--now" ] && now="--now"

    # --uid so the checkout does not end up owned by root; the service user is
    # whoever invoked sudo.
    set -- systemd-run --collect --quiet \
        --uid="${SUDO_USER:-$(id -un)}" \
        --working-directory="$ROOT" \
        --unit=skylapse-update \
        "$ROOT/venv/bin/python" -m skylapse.updater apply "$ref" $now
    if [ -n "${SKYLAPSE_PRINT_ONLY:-}" ]; then
        echo "$@"                       # for the tests; never set in service
        exit 0
    fi
    exec "$@"
    ;;

  reinstall-units)
    # Re-apply the systemd units and the sudoers file from the checkout.
    #
    # The in-app updater is `git checkout` plus a pip install and an npm build.
    # It has never touched /etc, so a change to a unit file or to this script's
    # sudoers entry simply did not apply to any rig that updated rather than
    # reflashed — which is exactly why the broken sudoers rule that made the
    # updater unusable could not be fixed by the updater.
    #
    # Called from the updater's build step when systemd/ or scripts/ changed,
    # and again on rollback, so the units always match the code that is checked
    # out.
    UNIT_DIR="${SKYLAPSE_UNIT_DIR:-/etc/systemd/system}"
    SUDOERS_PATH="${SKYLAPSE_SUDOERS_PATH:-/etc/sudoers.d/skylapse}"
    # The checkout's owner is the service user by construction — install.sh
    # chowns it — and is more reliable here than SUDO_USER, which is whoever
    # happened to invoke this.
    user="$(stat -c %U "$ROOT" 2>/dev/null || echo "${SUDO_USER:-root}")"

    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    sed -e "s|@SKYLAPSE_ROOT@|$ROOT|g" -e "s|@SKYLAPSE_USER@|$user|g" \
        "$ROOT/systemd/skylapse.sudoers" > "$tmp/skylapse.sudoers"
    # A malformed sudoers file locks everyone out of sudo, including the helper
    # that would be needed to repair it. Validate before it goes anywhere near
    # /etc, exactly as install.sh does.
    if command -v visudo >/dev/null 2>&1; then
        visudo -cqf "$tmp/skylapse.sudoers" || {
            echo "refusing to install a malformed sudoers file" >&2; exit 7; }
    fi
    # Ownership only when we are actually root — which is every real
    # invocation, since sudo is how this runs. Asking for it otherwise fails on
    # a developer machine that has no root user, for no gain.
    if [ "$(id -u)" -eq 0 ]; then
        install -m 440 -o root -g root "$tmp/skylapse.sudoers" "$SUDOERS_PATH"
    else
        install -m 440 "$tmp/skylapse.sudoers" "$SUDOERS_PATH"
    fi

    mkdir -p "$UNIT_DIR"
    for unit in skylapse-daemon skylapse-api skylapse-netwatch; do
        [ -f "$ROOT/systemd/$unit.service" ] || continue
        sed -e "s|@SKYLAPSE_ROOT@|$ROOT|g" -e "s|@SKYLAPSE_USER@|$user|g" \
            "$ROOT/systemd/$unit.service" > "$UNIT_DIR/$unit.service"
    done
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload
    fi
    echo "reinstalled units for $user"
    ;;

  restart-services)
    # Same story as `update`: the sudoers rule named three units and the
    # updater restarts two, so it matched nothing and the restart failed with a
    # password prompt — which the updater then correctly treated as a failed
    # update and rolled back.
    # shellcheck disable=SC2086
    systemctl restart $SERVICES
    echo "restarted $SERVICES"
    ;;

  tailscale-install)
    if command -v tailscale >/dev/null 2>&1; then
        echo "tailscale already installed"
    else
        # Validated before anything else is checked: what this resolves to
        # decides which URL is fetched, so an unrecognised system is a refusal
        # rather than a guess at an apt source to add to someone's camera.
        codename="$(os_codename)" || {
            echo "cannot identify this OS release; install tailscale manually" >&2
            exit 4; }
        command -v curl >/dev/null 2>&1 || { echo "curl is not installed" >&2; exit 5; }

        # Staged, because a truncated keyring in place is worse than none: apt
        # then fails every update on the system, not just this install.
        tmp="$(mktemp -d)"
        trap 'rm -rf "$tmp"' EXIT
        curl -fsSL --retry 3 --connect-timeout 15 --max-time 120 \
             -o "$tmp/keyring.gpg" "$TS_BASE_URL/$codename.noarmor.gpg" || {
            echo "could not fetch the Tailscale signing key for $codename" >&2
            exit 6; }
        [ -s "$tmp/keyring.gpg" ] || { echo "empty signing key" >&2; exit 6; }
        curl -fsSL --retry 3 --connect-timeout 15 --max-time 120 \
             -o "$tmp/tailscale.list" "$TS_BASE_URL/$codename.tailscale-keyring.list" || {
            echo "could not fetch the Tailscale apt source for $codename" >&2
            exit 6; }
        grep -q '^deb ' "$tmp/tailscale.list" || {
            echo "apt source does not look like one" >&2; exit 6; }

        install -m 0644 "$tmp/keyring.gpg" "$TS_KEYRING"
        install -m 0644 "$tmp/tailscale.list" "$TS_SOURCES"

        # Only this source: a full `apt-get update` on a camera pulls every
        # index it has, which is slow on a Pi and is not what was asked for.
        apt-get update -o Dir::Etc::sourcelist="$TS_SOURCES" \
                       -o Dir::Etc::sourceparts="-" -o APT::Get::List-Cleanup="0"
        DEBIAN_FRONTEND=noninteractive apt-get install -y tailscale
    fi
    # Enabled but not authenticated: the machine joins nothing until someone
    # completes the login, which is the next verb.
    systemctl enable --now tailscaled
    echo "tailscale-install ready"
    ;;

  tailscale-up)
    # Prints a login URL on stdout and then blocks until that login completes,
    # which is why the caller streams this rather than waiting for it.
    # --accept-dns=false: a camera that starts taking its resolver from a
    # tailnet is a camera that can lose its own network for reasons nobody
    # standing next to it can see.
    exec tailscale up --accept-dns=false --hostname="$(hostname)"
    ;;

  tailscale-serve)
    # Puts the local UI on the tailnet's HTTPS name with a real certificate.
    # Without this the address the settings card shows resolves to a machine
    # serving nothing on 443.
    tailscale serve --bg 80
    ;;

  tailscale-down)
    tailscale down
    ;;

  tailscale-status)
    tailscale status --json
    ;;

  i2c-enable)
    # The BME280 the dew heater reads sits on I2C, and Raspberry Pi OS ships
    # the bus switched off. Turning it on means a line in the boot config and a
    # reboot — which on an appliance with no terminal is otherwise a dead end,
    # exactly like the camera overlay was.
    cp -n "$CONFIG" "$CONFIG.skylapse-backup" 2>/dev/null || true
    if grep -q "^dtparam=i2c_arm=" "$CONFIG"; then
        sed -i "s/^dtparam=i2c_arm=.*/dtparam=i2c_arm=on/" "$CONFIG"
    else
        printf "
dtparam=i2c_arm=on
" >> "$CONFIG"
    fi
    # Loadable now as well as at boot, so a sensor already wired up answers
    # without waiting for the reboot.
    if command -v modprobe >/dev/null 2>&1; then
        modprobe i2c-dev 2>/dev/null || true
    fi
    if [ -e /dev/i2c-1 ]; then
        echo "i2c ready"
    else
        echo "i2c enabled; needs a reboot"
    fi
    ;;

  reboot)
    # Detached, so the caller can answer the HTTP request it is still holding
    # before the machine goes down under it.
    systemd-run --collect --quiet --on-active=2s /sbin/reboot
    echo "rebooting"
    ;;

  *) usage ;;
esac
